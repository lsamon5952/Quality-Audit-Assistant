{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role category and academic position. Does not store email.",
      "type": "object",
      "properties": {
        "department": { "type": "string", "maxLength": 100 },
        "roleCategory": { "type": "string", "enum": ["Teaching Faculty", "Academic Leadership", "Office Staff"] },
        "position": { "type": "string", "maxLength": 100 },
        "jobFunction": { "type": "string", "maxLength": 500 },
        "yearsInRole": { "type": "integer" },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 }
      },
      "required": ["department", "roleCategory", "position", "jobFunction", "yearsInRole", "displayName"]
    },
    "Review": {
      "title": "Review",
      "description": "Process review record for an employee with status and optional Process Risk Sheet",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["in_progress", "completed"] },
        "step": { "type": "integer" },
        "profileSnapshot": { "type": "object" },
        "riskSheet": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reviewId", "userId", "status", "step", "createdAt"]
    },
    "Interaction": {
      "title": "Interaction",
      "description": "Single turn interaction (message) within a review session",
      "type": "object",
      "properties": {
        "interactionId": { "type": "string", "maxLength": 128 },
        "reviewId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientMessageId": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "maxLength": 2000, "minLength": 1 },
        "step": { "type": "integer" },
        "modelUsed": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["interactionId", "reviewId", "userId", "clientMessageId", "role", "content", "timestamp"]
    },
    "BaselineSettings": {
      "title": "BaselineSettings",
      "description": "College quality baseline requirements stored in a single document",
      "type": "object",
      "properties": {
        "documents": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["documents", "updatedAt", "updatedBy"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Manual admin record configured directly in Firebase Console",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["superadmin"] }
      },
      "required": ["role"]
    },
    "RiskReport": {
      "title": "RiskReport",
      "description": "Consolidated process risk report generated by the administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "markdown": { "type": "string" },
        "stats": { "type": "object" }
      },
      "required": ["id", "createdAt", "createdBy", "markdown", "stats"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Employee profile"
    },
    "/users/{userId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Process reviews per employee"
    },
    "/users/{userId}/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "Review chat messages"
    },
    "/settings/baseline": {
      "schema": "BaselineSettings",
      "description": "College quality baseline documents"
    },
    "/admins/{uid}": {
      "schema": "AdminRecord",
      "description": "Super administrator authorization record"
    },
    "/riskReports/{reportId}": {
      "schema": "RiskReport",
      "description": "Admin consolidated risk reports"
    }
  }
}
